{
  "name": "ella-street-festival-booking-system",
  "version": "1.0.0-rc3",
  "description": "",
  "main": "js/config.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./css/input.css -o ./css/output.css --watch",
    "dev": "node scripts/dev-server.mjs",
    "postinstall": "git config core.hooksPath .githooks || true",
    "check:rls-grants": "bash scripts/check-rls-grants-snapshot.sh",
    "check:innerhtml-escaping": "node scripts/check-unescaped-innerhtml.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test:setup": "node scripts/seed-test-project.mjs",
    "test:integration": "node --test --test-concurrency=1",
    "test:a11y": "playwright test --project=public",
    "test:a11y:admin": "playwright test --project=setup --project=admin",
    "test": "npm run test:setup && npm run test:integration && npm run test:a11y && npm run test:a11y:admin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.110.5",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^7.0.2"
  }
}
